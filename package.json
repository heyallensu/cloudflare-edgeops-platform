{
  "name": "cloudflare-edgeops-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:static": "node --test test/static/*.test.mjs",
    "test:integration": "vitest run test/integration",
    "test:e2e": "playwright test",
    "test:e2e:protected": "playwright test --config playwright.protected.config.ts",
    "test:watch": "vitest",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "d1:migrate:local": "wrangler d1 migrations apply edgeops-dashboard-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply edgeops-dashboard-db --remote",
    "verify": "npm run cf-typegen && npm run typecheck && npm run lint && npm test && npm run test:static && npm run build:worker"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.19.9",
    "jose": "^6.2.3",
    "next": "16.2.6",
    "react": "^19.1.7",
    "react-dom": "^19.1.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.5",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/react": "^19.1.7",
    "@types/react-dom": "^19.1.7",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5.7.4",
    "vitest": "^4.1.10",
    "wrangler": "4.112.0"
  },
  "overrides": {
    "postcss": "8.5.19"
  }
}
